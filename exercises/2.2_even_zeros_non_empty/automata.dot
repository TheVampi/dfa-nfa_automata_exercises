digraph finite_automata {
  rankdir=LR;
  
  node [shape = point]; init;
  node [shape = doublecircle]; q2;
  node [shape = circle]; q0 q1;

  init -> q0;
  
  q0 -> q1 [label = "0"];
  q0 -> q2 [label = "1"];
  
  q1 -> q2 [label = "0"];
  q1 -> q1 [label = "1"];

  q2 -> q1 [label = "0"];
  q2 -> q2 [label = "1"];
}