digraph finite_automata {
  rankdir=LR;
  
  node [shape = point]; init;
  node [shape = doublecircle]; q3;
  node [shape = circle]; q0 q1 q2;
  
  init -> q0;
  
  q0 -> q0 [label = "b"];
  q0 -> q1 [label = "a"];
  
  q1 -> q1 [label = "a"];
  q1 -> q2 [label = "b"];
  
  q2 -> q1 [label = "a"];
  q2 -> q3 [label = "b"];
  
  q3 -> q1 [label = "a"];
  q3 -> q0 [label = "b"];
}