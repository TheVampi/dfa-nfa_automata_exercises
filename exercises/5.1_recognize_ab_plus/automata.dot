digraph finite_automata {
  rankdir=LR;
  
  node [shape = point]; init;
  node [shape = doublecircle]; q2;
  node [shape = circle]; q0 q1 q3;

  init -> q0;
  
  q0 -> q1 [label = "a"];
  q0 -> q3 [label = "b"];
  
  q1 -> q3 [label = "a"];
  q1 -> q2 [label = "b"];

  q2 -> q1 [label = "a"];
  q2 -> q3 [label = "b"];
  
  q3 -> q3 [label = "a,b"];
}