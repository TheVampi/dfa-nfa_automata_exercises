digraph finite_automata {
  rankdir=LR;
  
  node [shape = point]; init;
  node [shape = doublecircle]; q3 q4;
  node [shape = circle]; q0 q1 q2 q5;

  init -> q0;
  
  q0 -> q1 [label = "0"];
  q0 -> q2 [label = "1"];
  
  q1 -> q3 [label = "0"];
  q1 -> q2 [label = "1"];

  q2 -> q1 [label = "0"];
  q2 -> q5 [label = "1"];
  
  q3 -> q3 [label = "0"];
  q3 -> q4 [label = "1"];

  q4 -> q3 [label = "0"];
  q4 -> q5 [label = "1"];

  q5 -> q5 [label = "0,1"];
}